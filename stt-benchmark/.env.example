# Copy to stt-benchmark/.env and fill in whatever you have.
# Any model whose keys are missing is simply greyed out in the UI.
# The harness also reads ../.env (the backend's own file), so Azure/OpenAI keys
# already configured for the API are picked up automatically.

# --- Azure AI Speech (what production uses today) --------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast
# AZURE_SPEECH_ENDPOINT=https://australiaeast.api.cognitive.microsoft.com
# AZURE_SPEECH_API_VERSION=2024-11-15

# --- Google: Speech-to-Text v1 (simplest — just an API key) ----------
# Cloud console > APIs & Services > Credentials > API key,
# with the Cloud Speech-to-Text API enabled on the project.
GOOGLE_SPEECH_API_KEY=

# --- Google: Chirp 2 via Speech-to-Text v2 (best Google model) -------
# Needs a service account with roles/speech.client. Either point at the JSON
# file, or paste the whole JSON on one line into GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\prepsmart-speech.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_PROJECT_ID=
# GOOGLE_SPEECH_LOCATION=us-central1

# --- Google: Gemini audio (AI Studio key) ----------------------------
GEMINI_API_KEY=

# --- OpenAI ----------------------------------------------------------
OPENAI_API_KEY=

# --- Optional extras -------------------------------------------------
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# AWS Transcribe: needs a bucket the harness may write scratch audio into,
# plus `npm i @aws-sdk/client-s3 @aws-sdk/client-transcribe` inside this folder.
# AWS_REGION=ap-southeast-2
# AWS_TRANSCRIBE_BUCKET=

# --- Harness settings ------------------------------------------------
# STT_BENCH_PORT=5055
# STT_BENCH_TIMEOUT_MS=300000
